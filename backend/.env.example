# ===== EduAgent Backend — Environment Variables =====
# Copy this file to .env and fill in real values

# --- Supabase ---
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJ...

# --- n8n ---
N8N_BASE_URL=http://localhost:5678
N8N_API_KEY=your_n8n_api_key
N8N_WEBHOOK_INGESTA=http://localhost:5678/webhook/ingesta-pdf
N8N_WEBHOOK_PLANEACION=http://localhost:5678/webhook/planeacion
N8N_WEBHOOK_EVALUACION=http://localhost:5678/webhook/evaluacion
N8N_WEBHOOK_CONSULTA=http://localhost:5678/webhook/consulta

# --- API Keys (used by n8n, not directly by FastAPI) ---
OPENAI_API_KEY=sk-...
OPENROUTER_API_KEY=sk-or-...
GOOGLE_AI_API_KEY=AIza...

# --- App ---
CORS_ORIGINS=http://localhost:3000,https://tudominio.com
N8N_WEBHOOK_SECRET=your_shared_secret
