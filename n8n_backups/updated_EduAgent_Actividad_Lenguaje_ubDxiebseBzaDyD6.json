      "typeVersion": 1.1,
      "credentials": {
        "openAiApi": {
          "id": "Jowod5NKcwNTE2fL",
          "name": "OpenAI account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "let raw = $input.first().json.text ?? $input.first().json.output ?? '';\nif (typeof raw !== 'string') {\n  return [{ json: raw }];\n}\nraw = raw.replace(/^```(?:json)?\\s*/i, '').replace(/```\\s*$/i, '').trim();\nconst first = raw.indexOf('{');\nconst last = raw.lastIndexOf('}');\nif (first !== -1 && last !== -1) {\n  raw = raw.substring(first, last + 1);\n}\nreturn [{ json: JSON.parse(raw) }];"
      },
