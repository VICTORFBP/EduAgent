{
  "name": "EduAgent - Generación de Actividad (AI)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "generar-actividad",
        "responseMode": "lastNode",
        "options": {}
      },
      "id": "a1",
      "name": "Webhook",
      "position": [-200, 120],
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1
    },
    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body;\nconst area = (body.area || '').toLowerCase();\nlet workflowId = 'EzYiDzu8IYTvv56L';\nif (area.includes('matematica') || area.includes('matemática')) {\n  workflowId = 'spnDlvMJdmA1Cdu9';\n} else if (area.includes('lenguaje') || area.includes('castellano')) {\n  workflowId = 'ubDxiebseBzaDyD6';\n}\nreturn [{ json: { body, workflowId } }];"
      },
      "id": "a6",
      "name": "RouteByArea",
      "position": [0, 120],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2
    },
    {
      "parameters": {
        "workflowId": {
          "__rl": true,
          "value": "={{ $json.workflowId }}",
          "mode": "id"
        },
        "mode": "once",
        "options": {}
      },
      "id": "a7",
      "name": "ExecuteSubworkflow",
      "position": [220, 120],
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2
    },
    {
      "parameters": {
        "jsCode": "const planeacionId = $('Webhook').first().json.body.planeacion_id;\nconst item = $input.first().json;\nconst actividad = item.titulo != null ? item : (item.actividad ?? item);\nreturn [{ json: { actividad, planeacion_id: planeacionId } }];"
      },
      "id": "a8",
      "name": "WrapActividad",
      "position": [440, 120],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2
    },
    {
      "parameters": {
        "operation": "update",
        "tableId": "planeaciones",
        "filters": {
          "conditions": [
            {
              "keyName": "id",
              "condition": "eq",
              "keyValue": "={{ $('Webhook').first().json.body.planeacion_id }}"
            }
          ]
        },
        "fieldsUi": {
          "fieldValues": [
            {
              "fieldId": "actividad_generada",
              "fieldValue": "={{ $json.actividad }}"
            }
          ]
        }
      },
      "id": "a4",
      "name": "SupabaseUpdate",
      "position": [660, 120],
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1
    }
  ],
  "connections": {
    "Webhook": {
      "main": [[{ "node": "RouteByArea", "type": "main", "index": 0 }]]
    },
    "RouteByArea": {
      "main": [[{ "node": "ExecuteSubworkflow", "type": "main", "index": 0 }]]
    },
    "ExecuteSubworkflow": {
      "main": [[{ "node": "WrapActividad", "type": "main", "index": 0 }]]
    },
    "WrapActividad": {
      "main": [[{ "node": "SupabaseUpdate", "type": "main", "index": 0 }]]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "_meta": {
    "n8nId": "hEQzKCEwOLvgLcIL",
    "subworkflows": {
      "matematicas": "spnDlvMJdmA1Cdu9",
      "lenguaje": "ubDxiebseBzaDyD6",
      "general": "EzYiDzu8IYTvv56L"
    }
  }
}
