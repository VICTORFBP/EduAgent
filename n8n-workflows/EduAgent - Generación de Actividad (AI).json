{
  "name": "EduAgent - Generación de Actividad (AI)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "generar-actividad",
        "responseMode": "lastNode",
        "options": {}
      },
      "id": "a1",
      "name": "Webhook",
      "position": [
        -200,
        120
      ],
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1
    },
    {
      "parameters": {
        "workflowId": "spnDlvMJdmA1Cdu9"
      },
      "id": "exec_m",
      "name": "ExecMath",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1,
      "position": [
        200,
        -20
      ]
    },
    {
      "parameters": {
        "workflowId": "ubDxiebseBzaDyD6"
      },
      "id": "exec_l",
      "name": "ExecLang",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1,
      "position": [
        200,
        120
      ]
    },
    {
      "parameters": {
        "workflowId": "EzYiDzu8IYTvv56L"
      },
      "id": "exec_g",
      "name": "ExecGen",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1,
      "position": [
        200,
        260
      ]
    },
    {
      "parameters": {
        "jsCode": "for (const item of $input.all()) {\n  const data = item.json;\n  item.json = { actividad: data, id: $(\"Webhook\").first().json.body.planeacion_id };\n}\nreturn $input.all();"
      },
      "id": "a5",
      "name": "SetProperties",
      "position": [
        400,
        120
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2
    },
    {
      "parameters": {
        "operation": "update",
        "tableId": "planeaciones",
        "filterType": "manual",
        "matchType": "anyFilter",
        "filters": {
          "conditions": [
            {
              "keyName": "id",
              "condition": "eq",
              "keyValue": "={{ $('Webhook').first().json.body.planeacion_id }}"
            }
          ]
        },
        "dataToSend": "defineBelow",
        "fieldsUi": {
          "fieldValues": [
            {
              "fieldId": "actividad_generada",
              "fieldValue": "={{ $json.actividad }}"
            }
          ]
        },
        "options": {}
      },
      "id": "a4",
      "name": "SupabaseUpdate",
      "position": [
        600,
        120
      ],
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "credentials": {
        "supabaseApi": {
          "id": "hdMca8ziAD6HN8DO",
          "name": "Supabase account"
        }
      }
    },
    {
      "id": "if_math",
      "name": "IfMath",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        0,
        120
      ],
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{$json.body.area}}",
              "operation": "contains",
              "value2": "Matemáticas"
            }
          ]
        }
      }
    },
    {
      "id": "if_lang",
      "name": "IfLang",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        100,
        260
      ],
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{$json.body.area}}",
              "operation": "contains",
              "value2": "Lenguaje"
            }
          ]
        }
      }
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
