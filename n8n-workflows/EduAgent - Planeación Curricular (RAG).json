      "position": [
        300,
        500
      ],
      "type": "@n8n/n8n-nodes-langchain.vectorStoreSupabase",
      "typeVersion": 1,
      "credentials": {
        "supabaseApi": {
          "id": "hdMca8ziAD6HN8DO",
          "name": "Supabase account"
        }
      }
    },
    {
      "parameters": {
        "options": {}
      },
      "id": "n6",
      "name": "Embeddings",
      "position": [
        100,
        500
      ],
      "type": "@n8n/n8n-nodes-langchain.embeddingsOpenAi",
      "typeVersion": 1.2,
      "credentials": {
        "openAiApi": {
          "id": "Jowod5NKcwNTE2fL",
          "name": "OpenAI account"
        }
      }
    },
    {
      "parameters": {
        "tableId": "planeaciones",
        "dataToSend": "defineBelow",
        "fieldsUi": {
          "fieldValues": [
            {
              "fieldId": "docente_id",
              "fieldValue": "={{$('Webhook').first().json.body.docente_id}}"
            },
            {
              "fieldId": "area",
              "fieldValue": "={{$('Webhook').first().json.body.area}}"
            },
            {
              "fieldId": "grados",
              "fieldValue": "={{$('Webhook').first().json.body.grados}}"
            },
            {
              "fieldId": "tema",
              "fieldValue": "={{$('Webhook').first().json.body.tema}}"
            },
            {
              "fieldId": "contenido_generado",
              "fieldValue": "={{JSON.parse($('AIAgent').first().json.output)}}"
            },
            {
              "fieldId": "agente_usado",
              "fieldValue": "GPT-4o-Mini + RAG"
            },
            {
              "fieldId": "dba_referenciados",
              "fieldValue": "={{ [JSON.parse($('AIAgent').first().json.output).dba_citado] }}"
            }
          ]
        },
        "options": {}
      },
