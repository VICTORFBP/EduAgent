# ==========================================
# CONFIGURACIÓN GLOBAL (VPS / Docker Compose)
# ==========================================

# 1. Token del Túnel de Cloudflare (Zero Trust -> Networks -> Tunnels)
# Esto conecta el VPS con Cloudflare sin exponer puertos.
CLOUDFLARE_TUNNEL_TOKEN=tu_token_aqui

# ==========================================
# VARIABLES DEL FRONTEND (Next.js)
# NOTA: Deben estar presentes al momento de hacer el build (docker compose build)
# ==========================================
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu_anon_key
# URL a la que apuntará el frontend. Puede ser la URL pública del backend o la misma del frontend si usas el rewrite de Next.js.
NEXT_PUBLIC_API_URL=https://api.vicdev.org

# ==========================================
# VARIABLES DEL BACKEND (FastAPI)
# ==========================================
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_KEY=tu_service_role_key

# OpenAI
OPENAI_API_KEY=sk-tu_api_key

# JWT (si usas autenticación custom además de Supabase)
JWT_SECRET=tu_jwt_secret_largo_y_seguro

# URL para configurar CORS en FastAPI
CORS_ORIGINS=https://vicdev.org
